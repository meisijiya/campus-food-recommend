# --- Build ---
target/
build/
out/
*.class
*.jar
*.war
*.ear

# --- Maven wrapper ---
.mvn/wrapper/maven-wrapper.jar

# --- IDE ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Logs / temp ---
*.log
logs/
tmp/
.tmp/

# --- Secrets(必须不跟踪) ---
.env
.env.*
secrets/

# --- Harness 任务级暂存(完成即删,不跟踪) ---
.scratch/

# --- Spring Boot ---
spring-boot-*.log

# --- Docker ---
# 镜像构建产物若临时落到仓库根可忽略;compose 文件本身跟踪
docker-data/

# --- Python (locust 压测,见 ADR-0004) ---
.venv/
__pycache__/
*.pyc
uv.lock
# 压测报告产物(每 ticket 自己出 csv 到 evidence/)
evidence/*.csv
evidence/**/*.csv

# --- JMeter 压测原始数据(占体积大,数字摘要已在工单 evidence 段,重跑 jmx plan 即可复现) ---
evidence/*.jtl
evidence/**/*.jtl
evidence/*.log
evidence/**/*.log

# --- Subagent-Driven Development workspace(plan/brief/report/ledger/diff;完成后即弃,git 历史是记录) ---
.superpowers/sdd/*/

# --- harness-creator 本会话审计产物(下次会话不再相关) ---
.far/

# --- Frontend (Vite + Vue3, F-16.1+, 见 ADR-0012) ---
# 工程源文件 tracked;依赖产物 / 构建产物 / dev cache 不 tracked
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/

# 截图清单(招实习现场 + README,本地维护,不入仓)
docs/design/frontend/screenshots/