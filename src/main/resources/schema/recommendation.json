{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-food-recommend/schemas/recommendation.json",
  "title": "Recommendation",
  "description": "AI 推荐接口的返回结构(F-3 阶段使用)",
  "type": "object",
  "required": ["merchantId", "reason", "confidence"],
  "additionalProperties": false,
  "properties": {
    "merchantId": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^m-[0-9a-zA-Z-]+$"
      },
      "description": "推荐商户 ID 列表,按 confidence 降序"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}