# 强制 LF 行尾,避免 Windows checkin 把 .sh 改成 CRLF
*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.java      text eol=lf
.editorconfig    text eol=lf
.gitattributes   text eol=lf
LICENSE          text eol=lf

# Windows native 脚本保留 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制明确标记
*.jar       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.jtl       binary
*.class     binary

# GitHub Linguist — 排除 generated / vendored 文件的语言统计
target/     linguist-generated=true
*.jtl       linguist-generated=true
evidence/*  linguist-generated=true
